# ============================================================
# .env.example — 环境变量模板
# ============================================================
# .env 已被 gitignore，克隆仓库后请复制本文件并重命名为 .env，填入真实配置。
# 本文件会提交到版本控制，请勿在此填写任何密钥或敏感信息。
# 新增环境变量时，需同步更新 /src/env.js 中的校验 schema。

# ============================================================
# 数据库
# ============================================================
# 完整数据库连接串。密码中若含 @ : / ? # & = + % 等字符需 URL percent-encode。
# 生产环境经容器部署时由 docker-compose 的 env_file 注入，migrate.mjs 会据此执行迁移。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organova"

# ============================================================
# 认证 (Better Auth)
# ============================================================
# 用于签发/验证 session cookie 的密钥。
# 生产环境必填，且**至少 32 字符**（src/env.js 会强校验，太短直接拒绝启动）：
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# 应用访问地址（生产环境必填）
#
# Vercel 上可以不填：一键部署时域名尚未分配，src/env.js 会自动兜底为
# VERCEL_PROJECT_PRODUCTION_URL（生产）或 VERCEL_URL（预览）。
# 绑定自定义域名后建议显式配置成该域名。
BETTER_AUTH_URL="http://localhost:3000"

# ============================================================
# 权限
# ============================================================
# 管理员邮箱白名单，多个用英文逗号分隔（可选）
ADMIN_EMAILS="admin@example.com"

# ============================================================
# 登录方式（单选）
# ============================================================
# 可选值: email-otp | email-password
# 默认 email-otp。运行时变量，改后 docker compose restart 即可生效（无需重新构建镜像）。
# AUTH_METHOD="email-otp"

# ============================================================
# 邮箱 SMTP（email-otp 登录验证码）
# ============================================================
# 开发环境验证码和通知会打印到控制台，无需配置。
# 生产环境必须填写 SMTP_USER 和 SMTP_PASS，其余视服务商填写。
# port=465 自动启用 SSL；port=587 自动使用 STARTTLS。
#
# --- QQ 邮箱 ---
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT=465
# SMTP_USER="yourname@qq.com"
# SMTP_PASS=""             # QQ 邮箱授权码（非登录密码），在 QQ 邮箱设置 > 账户 中生成
#
# --- Gmail ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="yourname@gmail.com"
# SMTP_PASS=""             # Gmail App Password（需开启两步验证后生成）
#
SMTP_USER=""
SMTP_PASS=""

# ============================================================
# 限流配置（可选，格式: "次数/窗口毫秒"，如 "5/60000" 表示每分钟5次）
# ============================================================
# 文件上传（默认 5次/分钟）
# RATE_LIMIT_UPLOAD="5/60000"
# 全局 IP 限流（默认 60次/分钟）
# RATE_LIMIT_GLOBAL_IP="60/60000"
# 登录/验证端点 IP 限流（默认 20次/分钟）。仅防暴力，验证另有 allowedAttempts 兜底，
# 阈值放宽以避免共享出口 IP（NAT/办公网）下误伤正常用户。
# RATE_LIMIT_AUTH_IP="20/60000"
# 验证码发送端点限流（默认 10次/分钟）。有邮件成本，与验证端点分离，单独严格限流。
# RATE_LIMIT_OTP_SEND="10/60000"
# 验证码校验端点限流（默认 10次/分钟）。覆盖 better-auth 内置过严规则（默认 3次/60s），
# 否则「先输错再输对」会被误判为「操作太频繁」。暴力破解由 OTP_ALLOWED_ATTEMPTS 兜底。
# RATE_LIMIT_OTP_VERIFY="10/60000"
# 单个验证码允许的错误次数（默认 5）。better-auth 默认 3 太低，达到上限后验证码会被作废，
# 之后即使输对也判「不正确」必须重新获取。
# OTP_ALLOWED_ATTEMPTS="5"

# 是否信任 X-Real-IP / X-Forwarded-For 头来推断客户端 IP（用于限流和审计 IP 字段）。
#
# 用本仓库自带的 docker-compose + nginx.conf 部署时必须为 true：
# nginx.conf 里 `proxy_set_header X-Real-IP $remote_addr` 会覆盖客户端伪造的同名头，
# 所以此处信任它是安全的。任何其他受信代理（CDN / 云负载均衡）同理。
#
# 保持 false 的后果：getClientIp 恒返回 'unknown'，于是
#   1. RATE_LIMIT_GLOBAL_IP 的 60次/分钟 变成「全站所有 /api/* 请求共享」，
#      两三个管理员同时操作后台就会开始吃 429；
#   2. 审计日志的 ip_address 字段恒为 NULL，失去追溯能力。
# 只有在「Next 进程直接暴露给公网、前面没有任何受信代理」时才应保持 false。
#
# 默认值：Vercel 上为 true（函数必经平台代理，XFF 由平台改写，伪造不了），
# 其余环境为 false。本仓库的 docker-compose 拓扑是 nginx 在前，所以这里给 true。
TRUST_PROXY_HEADERS="true"

# ============================================================
# 定时任务
# ============================================================
# /api/cron/* 的鉴权口令。不填则该端点直接返回 503（不会裸奔）。
#
# 目前只有一个任务：/api/cron/audit-purge —— 按后台「自动清理」配置删除过期审计日志。
# 不配置它的后果：自动清理只会在有管理员打开后台审计页时才被动触发一次，
# 长期无人访问后台的站点，日志会一直堆积。
#
# Vercel：在项目环境变量里配好本项，平台会按 vercel.json 的 crons 每天自动调用，
#         并自动带上 Authorization: Bearer <本项的值>。
# 自建：用系统 crontab 调用，需自己带同样的请求头：
#   0 4 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<域名>/api/cron/audit-purge
# CRON_SECRET=""

# Redis 限流后端（多实例共享计数）。未设时退化为进程内 Map（仅适合单机/开发）。
# 生产水平扩展务必设置；本地开发可不设。
# REDIS_URL="redis://default:password@localhost:6379/0"

# ============================================================
# 文件存储
# ============================================================
# 可选值: local | oss
# local: 存储到本地 public/uploads/（仅适合单机开发，不支持多实例/Serverless）
# oss:   阿里云 OSS（需填写下方 OSS 配置）
# 默认 local
#
# 部署到 Vercel 时必须设为 oss：Serverless 函数的文件系统只读且实例随时回收，
# local 分支的 writeFile 会直接失败。启动时 src/env.js 会就此打印告警。
# STORAGE_PROVIDER="local"

# ------------------------------------------------------------
# 阿里云 OSS（STORAGE_PROVIDER=oss 时必填）
# ------------------------------------------------------------
# OSS_REGION="oss-cn-hangzhou"         # Bucket 所在地域，如 oss-cn-hangzhou / oss-cn-shanghai
# OSS_ACCESS_KEY_ID=""                  # RAM 用户 AccessKey ID
# OSS_ACCESS_KEY_SECRET=""              # RAM 用户 AccessKey Secret
# OSS_BUCKET=""                         # Bucket 名称
# OSS_BASE_URL=""                       # 可选，CDN 或自定义域名（如 https://cdn.example.com）
#                                       # 不填则自动使用 https://{bucket}.{region}.aliyuncs.com

# ============================================================
# 部署
# ============================================================
# Nginx 容器对宿主机暴露的 HTTP 端口。
# - 直接对外（无 SSL 场景）：HOST_PORT=80
# - 由宿主机的反向代理（外层 nginx / 云负载均衡）接管 80/443 时：填一个不冲突的端口，如 31190
HOST_PORT=80
