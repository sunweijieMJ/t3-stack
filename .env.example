# ============================================================
# .env.example — 环境变量模板
# ============================================================
# .env 已被 gitignore，克隆仓库后请复制本文件并重命名为 .env，填入真实配置。
# 本文件会提交到版本控制，请勿在此填写任何密钥或敏感信息。
# 新增环境变量时，需同步更新 /src/env.js 中的校验 schema。

# ============================================================
# 数据库
# ============================================================
# 两种配置方式（二选一），容器启动时由 scripts/resolve-db-url.ts 解析：
#
# 【方式 A：直传完整 URL】本地开发 / 阿里云 / 任何已知密码的环境
#   密码中若含 @ : / ? # & = + % 等字符需 URL percent-encode
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organova"
#
# 【方式 B：AWS Secrets Manager 取密码】生产环境推荐，避免密码落盘
#   留空 DATABASE_URL，改为提供下列变量：
#     DB_SECRET_ARN  必填，RDS 主密码 secret 的 ARN（SecretString 需为 JSON，含 password 字段）
#     DB_HOST        必填，RDS endpoint
#     DB_USER        可选，默认取 secret.username
#     DB_NAME        可选，默认 postgres
#     DB_PORT        可选，默认 5432
#     DB_SSLMODE     可选，默认 require
#   需要 EC2 IAM Role 拥有 secretsmanager:GetSecretValue 权限。
# DB_SECRET_ARN="arn:aws:secretsmanager:us-east-1:xxx:secret:rds!cluster-xxx-xxxxxx"
# DB_HOST="database-2.cluster-xxx.us-east-1.rds.amazonaws.com"
# DB_USER="postgres"
# DB_NAME="postgres"
# DB_SSLMODE="require"

# ============================================================
# 认证 (Better Auth)
# ============================================================
# 用于签发/验证 JWT 的密钥（生产环境必填，可通过 openssl rand -base64 32 生成）
BETTER_AUTH_SECRET=""
# 应用访问地址（生产环境必填）
BETTER_AUTH_URL="http://localhost:3000"

# ============================================================
# 权限
# ============================================================
# 管理员邮箱白名单，多个用英文逗号分隔（可选）
ADMIN_EMAILS="admin@example.com"

# ============================================================
# 登录方式（单选）
# ============================================================
# 可选值: email-otp | email-password
# 默认 email-otp。运行时变量，改后 docker compose restart 即可生效（无需重新构建镜像）。
# AUTH_METHOD="email-otp"

# ============================================================
# 邮箱 SMTP（email-otp 登录验证码）
# ============================================================
# 开发环境验证码和通知会打印到控制台，无需配置。
# 生产环境必须填写 SMTP_USER 和 SMTP_PASS，其余视服务商填写。
# port=465 自动启用 SSL；port=587 自动使用 STARTTLS。
#
# --- QQ 邮箱 ---
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT=465
# SMTP_USER="yourname@qq.com"
# SMTP_PASS=""             # QQ 邮箱授权码（非登录密码），在 QQ 邮箱设置 > 账户 中生成
#
# --- Gmail ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="yourname@gmail.com"
# SMTP_PASS=""             # Gmail App Password（需开启两步验证后生成）
#
# --- AWS SES ---
# SMTP_HOST="email-smtp.us-east-1.amazonaws.com"   # 替换为对应区域
# SMTP_PORT=587
# SMTP_USER=""             # SES SMTP 用户名（IAM 凭证，非 Access Key ID）
# SMTP_PASS=""             # SES SMTP 密码
#
SMTP_USER=""
SMTP_PASS=""

# ============================================================
# 限流配置（可选，格式: "次数/窗口毫秒"，如 "5/60000" 表示每分钟5次）
# ============================================================
# 文件上传（默认 5次/分钟）
# RATE_LIMIT_UPLOAD="5/60000"
# 全局 IP 限流（默认 60次/分钟）
# RATE_LIMIT_GLOBAL_IP="60/60000"
# 登录/验证端点 IP 限流（默认 20次/分钟）。仅防暴力，验证另有 allowedAttempts 兜底，
# 阈值放宽以避免共享出口 IP（NAT/办公网）下误伤正常用户。
# RATE_LIMIT_AUTH_IP="20/60000"
# 验证码发送端点限流（默认 10次/分钟）。有邮件成本，与验证端点分离，单独严格限流。
# RATE_LIMIT_OTP_SEND="10/60000"
# 验证码校验端点限流（默认 10次/分钟）。覆盖 better-auth 内置过严规则（默认 3次/60s），
# 否则「先输错再输对」会被误判为「操作太频繁」。暴力破解由 OTP_ALLOWED_ATTEMPTS 兜底。
# RATE_LIMIT_OTP_VERIFY="10/60000"
# 单个验证码允许的错误次数（默认 5）。better-auth 默认 3 太低，达到上限后验证码会被作废，
# 之后即使输对也判「不正确」必须重新获取。
# OTP_ALLOWED_ATTEMPTS="5"

# 是否信任 X-Real-IP / X-Forwarded-For 头来推断客户端 IP（用于限流和审计 IP 字段）。
# 仅当请求一定经过受信代理（nginx / CDN）时设为 true，否则攻击者可伪造 IP 绕过限流。
# 默认 false：所有 IP 限流降级到全局共享桶，安全优先。
# TRUST_PROXY_HEADERS="false"

# Redis 限流后端（多实例共享计数）。未设时退化为进程内 Map（仅适合单机/开发）。
# 生产水平扩展务必设置；本地开发可不设。
# REDIS_URL="redis://default:password@localhost:6379/0"

# ============================================================
# 文件存储
# ============================================================
# 可选值: local | oss | s3
# local: 存储到本地 public/uploads/（仅适合单机开发，不支持多实例/Serverless）
# oss:   阿里云 OSS（需填写下方 OSS 配置）
# s3:    AWS S3 或兼容 S3 协议的服务（需填写下方 S3 配置）
# 默认 local
# STORAGE_PROVIDER="local"

# ------------------------------------------------------------
# 阿里云 OSS（STORAGE_PROVIDER=oss 时必填）
# ------------------------------------------------------------
# OSS_REGION="oss-cn-hangzhou"         # Bucket 所在地域，如 oss-cn-hangzhou / oss-cn-shanghai
# OSS_ACCESS_KEY_ID=""                  # RAM 用户 AccessKey ID
# OSS_ACCESS_KEY_SECRET=""              # RAM 用户 AccessKey Secret
# OSS_BUCKET=""                         # Bucket 名称
# OSS_BASE_URL=""                       # 可选，CDN 或自定义域名（如 https://cdn.example.com）
#                                       # 不填则自动使用 https://{bucket}.{region}.aliyuncs.com

# ------------------------------------------------------------
# AWS S3 / S3 兼容服务（STORAGE_PROVIDER=s3 时必填）
# ------------------------------------------------------------
# S3_REGION="us-east-1"                 # 存储桶所在区域
# S3_ACCESS_KEY_ID=""                   # IAM 用户 Access Key ID
# S3_SECRET_ACCESS_KEY=""               # IAM 用户 Secret Access Key
# S3_BUCKET=""                          # Bucket 名称
# S3_ENDPOINT=""                        # 可选，仅 S3 兼容服务需要填写（如 MinIO、Cloudflare R2）
#                                       # 标准 AWS S3 不需要填写此项
# S3_BASE_URL=""                        # 可选，CDN 或自定义域名（如 https://cdn.example.com）
#                                       # 不填则自动使用 https://{bucket}.s3.{region}.amazonaws.com

# ============================================================
# 部署
# ============================================================
# Nginx 容器对宿主机暴露的 HTTP 端口。
# - 直接对外（阿里云 ECS 等无 SSL 场景）：HOST_PORT=80
# - 由宿主机的反向代理（外层 nginx / 云负载均衡）接管 80/443 时：填一个不冲突的端口，如 31190
# HTTPS 终端走容器内（AWS EC2 + Let's Encrypt）请同时部署 docker-compose.https.yml
HOST_PORT=80
