  "patterns": [
    {
      "name": "jwt-token",
      "pattern": "/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/g"
    },
    {
      "name": "css-var",
      "pattern": "/--[a-zA-Z][a-zA-Z0-9-]*/g"
    },
    {
      "name": "import-path",
      "pattern": "/@\\/[a-zA-Z0-9/-]+/g"
    }
  ],
  "ignoreRegExpList": ["jwt-token", "css-var", "import-path"],
  "ignorePaths": [
    "**/*/node_modules",
    "**/*/playwright-report",
    "**/*/coverage",
    "**/*/dist",
    "**/*/build",
    "**/*/public",
    "**/*/__test__",
    "**/*/docs",
    ".next",
    ".husky/**/*",
    ".vscode/**/*",
    "scripts/**/*",
    "typings/**/*",
    ".browserslistrc",
    ".editorconfig",
    ".gitignore",
    "commitlint.config.ts",
    "pnpm-lock.yaml",
    "README.md",
    "tsconfig.json",
    "**/*/tsconfig.tsbuildinfo",
    "**/*/tsconfig.stories.tsbuildinfo",
    "**/*.svg",
    "**/*.sh",
    "**/*.conf",
    "**/*.png",
    "**/*.json",
    "**/*.lock",
    "**/*.ttf",
    "**/*.otf",
    "**/*.woff",
    "**/*.ogg",
    "**/*.yml",
    "**/*.scss"
  ]
}
